{
  "name": "codex-orchestrator",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --open\"",
    "build": "tsc -b && vite build",
    "desktop:bundle": "npm run build && node scripts/generate-icon.mjs && esbuild server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=build/server.cjs",
    "desktop:dist": "npm run desktop:bundle && electron-builder --win",
    "start": "npm run build && tsx server/index.ts",
    "check": "tsc -b --pretty false",
    "test": "tsx --test server/index.test.ts electron/lifecycle.test.cjs"
  },
  "dependencies": {
    "ajv8": "npm:ajv@^8.17.1",
    "express": "^5.1.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "electron": "35.7.5",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "build": {
    "appId": "com.codex.orchestrator",
    "productName": "Orchestrator",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [
      { "from": "dist", "to": "dist" },
      { "from": "build/server.cjs", "to": "server.cjs" },
      { "from": "build/icon.ico", "to": "icon.ico" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
