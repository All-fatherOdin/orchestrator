{
  "name": "codex-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --open\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && tsx server/index.ts",
    "check": "tsc -b --pretty false",
    "test": "tsx --test server/index.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
