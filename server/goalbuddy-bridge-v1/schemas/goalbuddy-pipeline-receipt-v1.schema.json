{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-orchestrator.local/schemas/goalbuddy-pipeline-receipt-v1.schema.json",
  "title": "GoalBuddyPipelineReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_type",
    "contract_version",
    "created_at",
    "pipeline_id",
    "project_path",
    "status",
    "stop_on_failure",
    "auto_commit",
    "goals"
  ],
  "properties": {
    "contract_type": { "const": "GoalBuddyPipelineReceiptV1" },
    "contract_version": { "const": "1.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "pipeline_id": { "type": "string", "minLength": 1 },
    "project_path": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["completed", "failed", "timed_out", "cancelled"]
    },
    "stop_on_failure": { "const": true },
    "auto_commit": { "const": false },
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "goal_slug",
          "state_path",
          "expected_state_sha256",
          "status"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "goal_slug": { "type": "string", "minLength": 1 },
          "state_path": { "type": "string", "minLength": 1 },
          "expected_state_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "run_id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["pending", "idle", "running", "paused", "completed", "failed", "timed_out", "cancelled"]
          }
        }
      }
    }
  }
}
