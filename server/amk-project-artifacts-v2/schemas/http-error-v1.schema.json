{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrator.local/schemas/amk-project-artifacts/http-error-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractType", "contractVersion", "code", "message", "readOnly", "navigationOnly", "activated", "filesModified"],
  "properties": {
    "contractType": { "const": "AmkProjectArtifactsErrorV1" },
    "contractVersion": { "const": "1.0" },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "message": { "type": "string", "minLength": 1, "maxLength": 256 },
    "readOnly": { "const": true },
    "navigationOnly": { "const": true },
    "activated": { "const": false },
    "filesModified": { "const": false }
  }
}
