{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrator.local/schemas/prompt-model-lineage-v1.schema.json",
  "title": "Prompt and model lineage contract v1",
  "oneOf": [
    { "$ref": "#/$defs/PromptArtifactV1" },
    { "$ref": "#/$defs/ModelRouteV1" },
    { "$ref": "#/$defs/AttemptConfigurationBindingV1" },
    { "$ref": "#/$defs/ResolvedModelExecutionV1" },
    { "$ref": "#/$defs/PromptModelLineageEventV1" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "gitObjectId": { "type": "string", "pattern": "^[a-f0-9]{40}(?:[a-f0-9]{24})?$" },
    "utcInstant": { "type": "string", "format": "date-time" },
    "stringSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/identifier" },
      "uniqueItems": true
    },
    "compilerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compilerId", "version"],
      "properties": {
        "compilerId": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/identifier" }
      }
    },
    "privacyValidationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validatorId", "validatorVersion", "decision", "validatedAt", "evidenceRefs"],
      "properties": {
        "validatorId": { "$ref": "#/$defs/identifier" },
        "validatorVersion": { "const": "1.0" },
        "decision": { "const": "approved" },
        "validatedAt": { "$ref": "#/$defs/utcInstant" },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "PromptArtifactV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType", "contractVersion", "promptArtifactId", "purpose", "artifactKind",
        "schemaVersion", "content", "contentHash", "byteLength", "inputSchemaRef",
        "behaviorContractRefs", "parentArtifactIds", "publishedBy", "publishedAt", "privacy"
      ],
      "properties": {
        "contractType": { "const": "PromptArtifactV1" },
        "contractVersion": { "const": "1.0" },
        "promptArtifactId": { "$ref": "#/$defs/identifier" },
        "purpose": { "$ref": "#/$defs/identity" },
        "artifactKind": {
          "enum": ["system", "executor", "reviewer", "correction", "planner", "architect", "warden_explanation", "eval_assertion"]
        },
        "schemaVersion": { "$ref": "#/$defs/identifier" },
        "content": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["storage", "mediaType", "text"],
              "properties": {
                "storage": { "const": "approved_reusable_content" },
                "mediaType": { "const": "text/plain; charset=utf-8" },
                "text": { "type": "string", "minLength": 1, "maxLength": 131072 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["storage", "orderedArtifactIds", "compiler"],
              "properties": {
                "storage": { "const": "manifest" },
                "orderedArtifactIds": {
                  "type": "array",
                  "items": { "$ref": "#/$defs/identifier" },
                  "minItems": 1
                },
                "compiler": { "$ref": "#/$defs/compilerIdentity" }
              }
            }
          ]
        },
        "contentHash": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "compiler": { "$ref": "#/$defs/compilerIdentity" },
        "inputSchemaRef": { "$ref": "#/$defs/identity" },
        "behaviorContractRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "minItems": 1,
          "uniqueItems": true
        },
        "parentArtifactIds": { "$ref": "#/$defs/stringSet" },
        "derivation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "operationVersion"],
          "properties": {
            "operation": { "enum": ["edit", "compose", "redact", "migrate"] },
            "operationVersion": { "$ref": "#/$defs/identifier" }
          }
        },
        "supersedesId": { "$ref": "#/$defs/identifier" },
        "publishedBy": { "$ref": "#/$defs/identity" },
        "publishedAt": { "$ref": "#/$defs/utcInstant" },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "validationReceipt"],
          "properties": {
            "classification": { "enum": ["approved_reusable", "manifest_only"] },
            "validationReceipt": { "$ref": "#/$defs/privacyValidationReceipt" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "parentArtifactIds": { "type": "array", "minItems": 1 } } },
          "then": { "properties": { "derivation": true }, "required": ["derivation"] },
          "else": { "properties": { "derivation": false } }
        },
        {
          "if": { "properties": { "content": { "type": "object", "properties": { "storage": { "const": "manifest" } }, "required": ["storage"] } } },
          "then": { "properties": { "privacy": { "type": "object", "properties": { "classification": { "const": "manifest_only" } } } } },
          "else": { "properties": { "privacy": { "type": "object", "properties": { "classification": { "const": "approved_reusable" } } } } }
        }
      ]
    },
    "ModelRouteV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType", "contractVersion", "modelRouteId", "routePolicyId", "routePolicyVersion",
        "requestedModelClass", "minimumModelClass", "reasoningLevel", "requiredCapabilities",
        "fallbackPolicy", "allowedProviderAdapters", "failClosedUnsupported", "routingRationaleCode",
        "publishedBy", "publishedAt"
      ],
      "properties": {
        "contractType": { "const": "ModelRouteV1" },
        "contractVersion": { "const": "1.0" },
        "modelRouteId": { "$ref": "#/$defs/identifier" },
        "routePolicyId": { "$ref": "#/$defs/identifier" },
        "routePolicyVersion": { "$ref": "#/$defs/identifier" },
        "requestedModelClass": { "$ref": "#/$defs/identifier" },
        "minimumModelClass": { "$ref": "#/$defs/identifier" },
        "reasoningLevel": { "enum": ["light", "medium", "high"] },
        "requiredCapabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtimeId", "toolRoute", "capabilityMapVersion"],
          "properties": {
            "runtimeId": { "$ref": "#/$defs/identifier" },
            "toolRoute": { "$ref": "#/$defs/identifier" },
            "capabilityMapVersion": { "$ref": "#/$defs/identifier" }
          }
        },
        "fallbackPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowedResolvedModelClasses", "allowedReasonCodes"],
          "properties": {
            "mode": { "enum": ["denied", "permitted"] },
            "allowedResolvedModelClasses": { "$ref": "#/$defs/stringSet" },
            "allowedReasonCodes": { "$ref": "#/$defs/stringSet" }
          }
        },
        "allowedProviderAdapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providerId", "adapterId", "adapterVersion"],
            "properties": {
              "providerId": { "$ref": "#/$defs/identifier" },
              "adapterId": { "$ref": "#/$defs/identifier" },
              "adapterVersion": { "$ref": "#/$defs/identifier" }
            }
          }
        },
        "failClosedUnsupported": { "const": true },
        "routingRationaleCode": { "$ref": "#/$defs/identifier" },
        "supersedesId": { "$ref": "#/$defs/identifier" },
        "publishedBy": { "$ref": "#/$defs/identity" },
        "publishedAt": { "$ref": "#/$defs/utcInstant" }
      }
    },
    "planReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planId", "revision", "planBaseSha"],
      "properties": {
        "planId": { "$ref": "#/$defs/identifier" },
        "revision": { "type": "integer", "minimum": 1 },
        "planBaseSha": { "$ref": "#/$defs/gitObjectId" }
      }
    },
    "expectedRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeId", "toolRoute", "capabilityMapVersion"],
      "properties": {
        "runtimeId": { "$ref": "#/$defs/identifier" },
        "toolRoute": { "$ref": "#/$defs/identifier" },
        "capabilityMapVersion": { "$ref": "#/$defs/identifier" }
      }
    },
    "AttemptConfigurationBindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType", "contractVersion", "bindingId", "bindingScope", "role", "projectId",
        "changeId", "waveId", "taskId", "runId", "attemptId", "plan", "authorizationId",
        "workspace", "promptArtifactIds", "compositeManifestHash", "compiler", "inputSchemaVersion",
        "inputFingerprint", "modelRouteId", "expectedRuntime", "boundBy", "reason", "boundAt",
        "publicationSequence", "evidenceSnapshotHash"
      ],
      "properties": {
        "contractType": { "const": "AttemptConfigurationBindingV1" },
        "contractVersion": { "const": "1.0" },
        "bindingId": { "$ref": "#/$defs/identifier" },
        "bindingScope": { "enum": ["attempt", "invocation"] },
        "role": { "enum": ["executor", "reviewer", "correction"] },
        "projectId": { "$ref": "#/$defs/identifier" },
        "changeId": { "$ref": "#/$defs/identifier" },
        "waveId": { "$ref": "#/$defs/identifier" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "invocationId": { "$ref": "#/$defs/identifier" },
        "parentAttemptBindingId": { "$ref": "#/$defs/identifier" },
        "plan": { "$ref": "#/$defs/planReference" },
        "authorizationId": { "$ref": "#/$defs/identifier" },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workspaceAttemptId", "repositoryId", "baseSha"],
          "properties": {
            "workspaceAttemptId": { "$ref": "#/$defs/identifier" },
            "repositoryId": { "$ref": "#/$defs/identifier" },
            "baseSha": { "$ref": "#/$defs/gitObjectId" }
          }
        },
        "promptArtifactIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1
        },
        "compositeManifestHash": { "$ref": "#/$defs/sha256" },
        "compiler": { "$ref": "#/$defs/compilerIdentity" },
        "inputSchemaVersion": { "$ref": "#/$defs/identifier" },
        "inputFingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "scopeId", "value"],
          "properties": {
            "algorithm": { "enum": ["scoped-sha256", "hmac-sha256"] },
            "scopeId": { "$ref": "#/$defs/identifier" },
            "value": { "$ref": "#/$defs/sha256" }
          }
        },
        "modelRouteId": { "$ref": "#/$defs/identifier" },
        "expectedRuntime": { "$ref": "#/$defs/expectedRuntime" },
        "boundBy": { "$ref": "#/$defs/identity" },
        "reason": { "$ref": "#/$defs/identity" },
        "boundAt": { "$ref": "#/$defs/utcInstant" },
        "publicationSequence": { "type": "integer", "minimum": 1 },
        "evidenceSnapshotHash": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "bindingScope": { "const": "attempt" } }, "required": ["bindingScope"] },
          "then": {
            "properties": { "role": { "const": "executor" } },
            "allOf": [
              { "properties": { "invocationId": false } },
              { "properties": { "parentAttemptBindingId": false } }
            ]
          },
          "else": { "properties": { "invocationId": true, "parentAttemptBindingId": true }, "required": ["invocationId", "parentAttemptBindingId"] }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["measured", "unsupported"] },
        "value": { "type": "number", "minimum": 0 },
        "unit": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "measured" } }, "required": ["state"] }, "then": { "properties": { "value": true, "unit": true }, "required": ["value", "unit"] }, "else": { "allOf": [{ "properties": { "value": false } }, { "properties": { "unit": false } }] } }
      ]
    },
    "ResolvedModelExecutionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType", "contractVersion", "resolutionId", "bindingId", "projectId", "changeId",
        "waveId", "taskId", "runId", "attemptId", "modelRouteId", "providerId", "providerAdapterId",
        "providerAdapterVersion", "runtimeId", "providerModelId", "resolvedModelClass", "capabilityMapVersion",
        "reasoningLevel", "toolRoute", "resolutionReasonCode", "fallback", "startedAt", "measurements"
      ],
      "properties": {
        "contractType": { "const": "ResolvedModelExecutionV1" },
        "contractVersion": { "const": "1.0" },
        "resolutionId": { "$ref": "#/$defs/identifier" },
        "bindingId": { "$ref": "#/$defs/identifier" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "changeId": { "$ref": "#/$defs/identifier" },
        "waveId": { "$ref": "#/$defs/identifier" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "runId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "invocationId": { "$ref": "#/$defs/identifier" },
        "modelRouteId": { "$ref": "#/$defs/identifier" },
        "providerId": { "$ref": "#/$defs/identifier" },
        "providerAdapterId": { "$ref": "#/$defs/identifier" },
        "providerAdapterVersion": { "$ref": "#/$defs/identifier" },
        "runtimeId": { "$ref": "#/$defs/identifier" },
        "providerModelId": { "$ref": "#/$defs/identity" },
        "resolvedModelClass": { "$ref": "#/$defs/identifier" },
        "capabilityMapVersion": { "$ref": "#/$defs/identifier" },
        "reasoningLevel": { "enum": ["light", "medium", "high"] },
        "toolRoute": { "$ref": "#/$defs/identifier" },
        "resolutionReasonCode": { "$ref": "#/$defs/identifier" },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["used"],
          "properties": {
            "used": { "type": "boolean" },
            "sourceModelClass": { "$ref": "#/$defs/identifier" },
            "reasonCode": { "$ref": "#/$defs/identifier" }
          },
          "allOf": [
            { "if": { "properties": { "used": { "const": true } }, "required": ["used"] }, "then": { "properties": { "sourceModelClass": true, "reasonCode": true }, "required": ["sourceModelClass", "reasonCode"] }, "else": { "allOf": [{ "properties": { "sourceModelClass": false } }, { "properties": { "reasonCode": false } }] } }
          ]
        },
        "providerRequestIdHash": { "$ref": "#/$defs/sha256" },
        "startedAt": { "$ref": "#/$defs/utcInstant" },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "latency", "cost", "cache", "providerMetadata"],
          "properties": {
            "inputTokens": { "$ref": "#/$defs/measurement" },
            "outputTokens": { "$ref": "#/$defs/measurement" },
            "latency": { "$ref": "#/$defs/measurement" },
            "cost": { "$ref": "#/$defs/measurement" },
            "cache": { "$ref": "#/$defs/measurement" },
            "providerMetadata": { "$ref": "#/$defs/measurement" }
          }
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entityId", "reasonCode", "reason", "evidenceRefs", "revokedBy", "revokedAt"],
      "properties": {
        "entityId": { "$ref": "#/$defs/identifier" },
        "reasonCode": { "$ref": "#/$defs/identifier" },
        "reason": { "$ref": "#/$defs/identity" },
        "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identity" } },
        "revokedBy": { "$ref": "#/$defs/identity" },
        "revokedAt": { "$ref": "#/$defs/utcInstant" }
      }
    },
    "PromptModelLineageEventV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "type", "occurredAt", "projectId", "changeId", "actor", "causationId", "correlationId", "payload", "previousHash", "hash"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "sequence": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["prompt.artifact-published", "prompt.artifact-revoked", "model.route-published", "model.route-revoked", "attempt.configuration-bound", "invocation.configuration-bound", "model.execution-resolved"] },
        "occurredAt": { "$ref": "#/$defs/utcInstant" },
        "projectId": { "$ref": "#/$defs/identifier" },
        "changeId": { "$ref": "#/$defs/identifier" },
        "waveId": { "$ref": "#/$defs/identifier" },
        "taskId": { "$ref": "#/$defs/identifier" },
        "actor": { "$ref": "#/$defs/identity" },
        "causationId": { "$ref": "#/$defs/identity" },
        "correlationId": { "$ref": "#/$defs/identity" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publisherOccurrenceId"],
          "properties": {
            "publisherOccurrenceId": { "$ref": "#/$defs/identifier" },
            "artifact": { "$ref": "#/$defs/PromptArtifactV1" },
            "route": { "$ref": "#/$defs/ModelRouteV1" },
            "binding": { "$ref": "#/$defs/AttemptConfigurationBindingV1" },
            "resolution": { "$ref": "#/$defs/ResolvedModelExecutionV1" },
            "revocation": { "$ref": "#/$defs/revocation" }
          },
          "oneOf": [
            { "properties": { "artifact": true }, "required": ["artifact"] },
            { "properties": { "route": true }, "required": ["route"] },
            { "properties": { "binding": true }, "required": ["binding"] },
            { "properties": { "resolution": true }, "required": ["resolution"] },
            { "properties": { "revocation": true }, "required": ["revocation"] }
          ]
        },
        "previousHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
