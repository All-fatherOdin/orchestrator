{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrator.local/schemas/context-budget-v1.schema.json",
  "title": "Context Budget v1",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "identity": { "type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,127}$" },
    "sourceClass": {
      "enum": [
        "repository_instructions",
        "selected_context_profile",
        "project_status_contract",
        "fixed_prompt_prefix",
        "host_owner_instructions",
        "host_skill_tool_descriptions"
      ]
    },
    "tokenEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "identity"],
      "properties": {
        "state": { "enum": ["measured", "estimated", "unsupported", "incomparable"] },
        "identity": { "$ref": "#/$defs/identity" },
        "count": { "type": "integer", "minimum": 0 },
        "tokenizerName": { "$ref": "#/$defs/identity" },
        "tokenizerVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "artifactHash": { "$ref": "#/$defs/sha256" },
        "configurationHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSourceCount": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 0 },
        "maxTokens": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["hard", "advisory"] }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "maxSources", "expectedPaths"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "maxSources": { "type": "integer", "minimum": 1, "maximum": 50 },
        "expectedPaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.][A-Za-z0-9_./-]*$" },
          "uniqueItems": true
        }
      }
    },
    "baselineSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClass", "identity", "sha256", "byteCount", "tokenEvidence", "envelope"],
      "properties": {
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "tokenEvidence": { "$ref": "#/$defs/tokenEvidence" },
        "envelope": { "$ref": "#/$defs/envelope" }
      }
    },
    "unsupportedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClass", "state", "reasonCode"],
      "properties": {
        "sourceClass": { "enum": ["host_owner_instructions", "host_skill_tool_descriptions"] },
        "state": { "const": "unsupported" },
        "reasonCode": { "const": "CONTEXT_BUDGET_HOST_SOURCE_UNSUPPORTED" }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractType", "contractVersion", "baselineId", "revision", "measurementPolicyId", "profiles", "sources", "unsupportedSources", "sourceSetHash", "baselineHash"],
      "properties": {
        "contractType": { "const": "ContextBudgetBaselineV1" },
        "contractVersion": { "const": "1.0" },
        "baselineId": { "$ref": "#/$defs/identity" },
        "revision": { "type": "integer", "minimum": 1 },
        "measurementPolicyId": { "const": "context-budget-measurement-v1" },
        "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/baselineSource" } },
        "unsupportedSources": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/unsupportedSource" } },
        "sourceSetHash": { "$ref": "#/$defs/sha256" },
        "baselineHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceClass", "identity", "sha256", "byteCount", "tokenEvidence", "baseline", "change", "envelopeStatus", "reasonCodes"],
      "properties": {
        "sourceClass": { "$ref": "#/$defs/sourceClass" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "tokenEvidence": { "$ref": "#/$defs/tokenEvidence" },
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["sha256", "byteCount", "tokenEvidence"],
          "properties": { "sha256": { "$ref": "#/$defs/sha256" }, "byteCount": { "type": "integer", "minimum": 0 }, "tokenEvidence": { "$ref": "#/$defs/tokenEvidence" } }
        },
        "change": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "byteDelta", "byteRelativeDelta"],
          "properties": {
            "state": { "enum": ["unchanged", "increased", "decreased"] },
            "byteDelta": { "type": "integer" },
            "byteRelativeDelta": { "anyOf": [{ "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{6}$" }, { "type": "null" }] },
            "tokenDelta": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
          }
        },
        "envelopeStatus": { "enum": ["pass", "advisory", "fail"] },
        "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractType", "contractVersion", "requestId", "baseline", "project", "measurementPolicyId", "sources", "unsupportedSources", "totals", "outcome", "reasonCodes", "wouldMutate", "scopeExpansion", "reportHash"],
      "properties": {
        "contractType": { "const": "ContextBudgetReportV1" },
        "contractVersion": { "const": "1.0" },
        "requestId": { "$ref": "#/$defs/identity" },
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["baselineId", "revision", "byteLength", "sha256", "baselineHash"],
          "properties": { "baselineId": { "$ref": "#/$defs/identity" }, "revision": { "type": "integer", "minimum": 1 }, "byteLength": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" }, "baselineHash": { "$ref": "#/$defs/sha256" } }
        },
        "project": {
          "type": "object", "additionalProperties": false,
          "required": ["head", "dirty", "overlappingPaths"],
          "properties": { "head": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" }, "dirty": { "type": "boolean" }, "overlappingPaths": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }
        },
        "measurementPolicyId": { "const": "context-budget-measurement-v1" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceResult" } },
        "unsupportedSources": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/unsupportedSource" } },
        "totals": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceCount", "byteCount", "tokenEvidence"],
          "properties": { "sourceCount": { "type": "integer", "minimum": 0 }, "byteCount": { "type": "integer", "minimum": 0 }, "tokenEvidence": { "$ref": "#/$defs/tokenEvidence" } }
        },
        "outcome": { "enum": ["pass", "pass-with-warnings", "fail"] },
        "reasonCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "uniqueItems": true },
        "wouldMutate": { "const": false },
        "scopeExpansion": {
          "type": "object", "additionalProperties": false,
          "required": ["runtime", "externalSystem", "data", "projectMapMutated"],
          "properties": { "runtime": { "const": false }, "externalSystem": { "const": false }, "data": { "const": false }, "projectMapMutated": { "const": false } }
        },
        "reportHash": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/baseline" },
    { "$ref": "#/$defs/report" }
  ]
}
