{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestrator.local/schemas/amk-queue-drafts-v1/queue-draft-v1.schema.json",
  "title": "AmkQueueDraftV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "git", "tasks"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "profileId", "defaultModel", "defaultEffort", "allowedModels"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "profileId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
        "defaultModel": { "enum": ["luna", "terra", "sol"] },
        "defaultEffort": { "enum": ["light", "medium", "high"] },
        "allowedModels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["luna", "terra", "sol"] }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointCommits"],
      "properties": { "checkpointCommits": { "const": false } }
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/Task" }
    }
  },
  "$defs": {
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "prompt", "allowedPaths", "verificationCommands", "executionGuards", "dependsOn"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$", "maxLength": 160 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "executionGuards": {
          "type": "array",
          "minItems": 3,
          "maxItems": 102,
          "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
        },
        "dependsOn": { "type": "array", "maxItems": 0 },
        "model": { "enum": ["auto", "luna", "terra", "sol"] },
        "effort": { "enum": ["light", "medium", "high"] }
      }
    }
  }
}
